generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String     @id @default(cuid())
  name      String
  username  String     @unique
  password  String
  role      UserRole   @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  xuatHang  XuatHang[]
  thuTien   ThuTien[]

  @@map("users")
}

enum LoaiVatTu {
  THUNG // Thùng
  CHAI
  NHAN // Nhãn
  TUI // Tui
  BAO
  SEAL
}

model VatTu {
  ms      String         @id
  loai    LoaiVatTu
  kho     Int            @default(0)
  gia     VatTuDonGia[]
  sanPham SanPhamVatTu[]

  @@map("vat_tu")
}

model VatTuDonGia {
  id     String   @id @default(cuid())
  ms     String
  ngay   DateTime @db.Date
  donGia Int
  vatTu  VatTu    @relation(fields: [ms], references: [ms], onDelete: Cascade, onUpdate: Cascade)

  @@unique([ms, ngay])
  @@index([ms, ngay])
  @@map("vat_tu_don_gia")
}

model KhachHang {
  mskh           String     @id
  ten            String
  tenCongTy      String?
  diaChi         String
  email          String?
  maSoThue       String?
  soDienThoai    String?
  tinh           String
  diaChiGiaoHang String?
  sdtChanh       String?
  sanPham        SanPham[]
  xuatHang       XuatHang[]
  thuTiens       ThuTien[]

  @@map("khach_hang")
}

model SanPham {
  mssp         String               @id
  mskh         String
  tenThuongMai String
  tenPhanBon   String
  quyCach      String
  quyCachThung Int
  donGia       Int
  tiTrong      Float?
  khoiLuong    Float                @default(0)
  khachHang    KhachHang            @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)
  nguyenLieu   CongThucNguyenLieu[]
  vatTu        SanPhamVatTu[]

  @@map("san_pham")
}

model SanPhamVatTu {
  mssp    String
  ms      String
  sanPham SanPham @relation(fields: [mssp], references: [mssp], onDelete: Cascade, onUpdate: Cascade)
  vatTu   VatTu   @relation(fields: [ms], references: [ms], onDelete: Restrict, onUpdate: Cascade)

  @@id([mssp, ms])
  @@map("san_pham_vat_tu")
}

model XuatHang {
  soPhieu         Int               @id @default(autoincrement())
  mskh            String
  ngayXuatHang    DateTime          @default(now())
  nguoiLapPhieuId String
  khachHang       KhachHang         @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)
  nguoiLapPhieu   User              @relation(fields: [nguoiLapPhieuId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  diaChiGiaoHang  String            @default("Nhận tại kho")
  sdtChanh        String?
  sanPham         XuatHangSanPham[]

  @@map("xuat_hang")
}

model XuatHangSanPham {
  soPhieu      Int
  mssp         String
  tenThuongMai String
  tenPhanBon   String
  quyCach      String
  quyCachThung Int
  donGia       Int
  soLuongThung Int
  soHangLe     Int                  @default(0)
  tongTien     Int                  @default(0)

  xuatHang     XuatHang             @relation(fields: [soPhieu], references: [soPhieu], onDelete: Cascade, onUpdate: Cascade)
  nguyenLieu   XuatHangNguyenLieu[]
  vatTu        XuatHangVatTu[]

  @@id([soPhieu, mssp])
  @@map("xuat_hang_san_pham")
}

model XuatHangNguyenLieu {
  id              String          @id @default(cuid())
  soPhieu         Int
  mssp            String
  tenNguyenLieu   String
  donGia          Int
  soLuong         Decimal         @db.Decimal(12, 3)
  tongTien        Int
  xuatHangSanPham XuatHangSanPham @relation(fields: [soPhieu, mssp], references: [soPhieu, mssp], onDelete: Cascade, onUpdate: Cascade)

  @@map("xuat_hang_nguyen_lieu")
}

model XuatHangVatTu {
  id              String          @id @default(cuid())
  soPhieu         Int
  mssp            String
  maVatTu         String
  donGia          Int
  soLuong         Int
  tongTien        Int
  xuatHangSanPham XuatHangSanPham @relation(fields: [soPhieu, mssp], references: [soPhieu, mssp], onDelete: Cascade, onUpdate: Cascade)

  @@map("xuat_hang_vat_tu")
}

model NguyenLieu {
  id      String               @id @default(cuid())
  ten     String
  donVi   String
  loai    String
  kho     Int                  @default(0)
  gia     NguyenLieuDonGia[]
  sanPham CongThucNguyenLieu[]

  @@map("nguyen_lieu")
}

model CongThucNguyenLieu {
  mssp         String
  nguyenLieuId String
  dinhLuong    Decimal    @db.Decimal(12, 3)
  sanPham      SanPham    @relation(fields: [mssp], references: [mssp], onDelete: Cascade, onUpdate: Cascade)
  nguyenLieu   NguyenLieu @relation(fields: [nguyenLieuId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([mssp, nguyenLieuId])
  @@map("cong_thuc_nguyen_lieu")
}

model NguyenLieuDonGia {
  id           String     @id @default(cuid())
  nguyenLieuId String
  ngay         DateTime   @db.Date
  donGia       Int
  nguyenLieu   NguyenLieu @relation(fields: [nguyenLieuId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([nguyenLieuId, ngay])
  @@index([nguyenLieuId, ngay])
  @@map("nguyen_lieu_don_gia")
}

model ThuTien {
  soPhieu   Int       @id @default(autoincrement())
  ngayThu   DateTime  @default(now())
  mskh      String
  soTien    Int
  lyDo      String
  noiNhan   String
  khachHang KhachHang @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@map("thu_tien")
}

enum LoaiHangNhap {
  NGUYEN_LIEU
  VAT_TU
}

model NhapHang {
  id         String       @id @default(cuid())
  ngayNhap   DateTime     @default(now())
  loai       LoaiHangNhap
  maHangNhap String
  donGia     Int
  soLuong    Int
  tongTien   Int
}

