generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum LoaiVatTu {
  THUNG // Thùng
  CHAI
  NHAN // Nhãn
  TUI // Túi
  BAO
}

model VatTu {
  ms          String     @id
  ten         LoaiVatTu
  loai        String
  mskh        String
  khachHang   KhachHang  @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)

  @@map("vat_tu")
}

model KhachHang {
  mskh         String   @id
  ten          String
  diaChi       String
  email        String?
  soDienThoai  String
  vatTus       VatTu[]

  @@map("khach_hang")
}
