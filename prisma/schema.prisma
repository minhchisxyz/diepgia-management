generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String     @id @default(cuid())
  name      String
  username  String     @unique
  password  String
  role      UserRole   @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  xuatHang  XuatHang[]
  thuTien   ThuTien[]

  @@map("users")
}

model KhachHang {
  mskh           String      @id
  ten            String
  tenCongTy      String?
  diaChi         String
  email          String?
  maSoThue       String?
  soDienThoai    String?
  tinh           String
  diaChiGiaoHang String?
  sdtChanh       String?
  quanLyMskh     String?
  quanLy         KhachHang?  @relation("QuanLyDaiLy", fields: [quanLyMskh], references: [mskh], onDelete: SetNull, onUpdate: Cascade)
  daiLy          KhachHang[] @relation("QuanLyDaiLy")
  sanPham        SanPham[]
  sanXuat        SanXuat[]
  xuatHang       XuatHang[]
  thuTiens       ThuTien[]
  congNos        CongNo[]

  @@map("khach_hang")
}

enum LoaiVatTu {
  THUNG // Thùng
  CHAI
  NHAN // Nhãn
  TUI // Tui
  BAO
  SEAL
}

model VatTuDonGia {
  id     String   @id @default(cuid())
  ms     String
  ngay   DateTime @db.Date
  donGia Int
  vatTu  VatTu    @relation(fields: [ms], references: [ms], onDelete: Cascade, onUpdate: Cascade)

  @@unique([ms, ngay])
  @@index([ms, ngay])
  @@map("vat_tu_don_gia")
}

model VatTu {
  ms      String         @id
  loai    LoaiVatTu
  kho     Int            @default(0)
  gia     VatTuDonGia[]
  sanPham SanPhamVatTu[]

  @@map("vat_tu")
}

model SanPhamVatTu {
  mssp    String
  ms      String
  sanPham SanPham @relation(fields: [mssp], references: [mssp], onDelete: Cascade, onUpdate: Cascade)
  vatTu   VatTu   @relation(fields: [ms], references: [ms], onDelete: Restrict, onUpdate: Cascade)

  @@id([mssp, ms])
  @@map("san_pham_vat_tu")
}

model XuatHangVatTu {
  id              String          @id @default(cuid())
  soPhieu         Int
  mssp            String
  maVatTu         String
  donGia          Int
  soLuong         Int
  tongTien        Int
  xuatHangSanPham XuatHangSanPham @relation(fields: [soPhieu, mssp], references: [soPhieu, mssp], onDelete: Cascade, onUpdate: Cascade)

  @@map("xuat_hang_vat_tu")
}

model NguyenLieuDonGia {
  id           String     @id @default(cuid())
  nguyenLieuId String
  ngay         DateTime   @db.Date
  donGia       Int
  nguyenLieu   NguyenLieu @relation(fields: [nguyenLieuId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([nguyenLieuId, ngay])
  @@index([nguyenLieuId, ngay])
  @@map("nguyen_lieu_don_gia")
}

model NguyenLieu {
  id      String              @id @default(cuid())
  ten     String
  donVi   String
  loai    String
  kho     Int                 @default(0)
  gia     NguyenLieuDonGia[]
  sanPham SanPhamNguyenLieu[]

  @@map("nguyen_lieu")
}

model SanPhamNguyenLieu {
  mssp         String
  nguyenLieuId String
  dinhLuong    Float
  sanPham      SanPham    @relation(fields: [mssp], references: [mssp], onDelete: Cascade, onUpdate: Cascade)
  nguyenLieu   NguyenLieu @relation(fields: [nguyenLieuId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([mssp, nguyenLieuId])
  @@map("san_pham_nguyen_lieu")
}

model XuatHangNguyenLieu {
  id              String          @id @default(cuid())
  soPhieu         Int
  mssp            String
  tenNguyenLieu   String
  donGia          Int
  dinhLuong       Float
  tongTien        Int
  xuatHangSanPham XuatHangSanPham @relation(fields: [soPhieu, mssp], references: [soPhieu, mssp], onDelete: Cascade, onUpdate: Cascade)

  @@map("xuat_hang_nguyen_lieu")
}

model SanXuatNguyenLieu {
  id               String         @id @default(cuid())
  sanXuatSanPhamId String
  sanXuatSanPham   SanXuatSanPham @relation(fields: [sanXuatSanPhamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenNguyenLieu    String
  donGia           Int
  dinhLuong        Float
  tongTien         Int

  @@map("san_xuat_nguyen_lieu")
}

model SanPham {
  mssp         String              @id
  mskh         String
  tenThuongMai String?
  tenPhanBon   String?
  quyCach      String
  quyCachThung Int
  donGia       Int
  tiTrong      Float?
  khoiLuong    Float               @default(0)
  khachHang    KhachHang           @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)
  nguyenLieu   SanPhamNguyenLieu[]
  vatTu        SanPhamVatTu[]

  @@map("san_pham")
}

model XuatHangSanPham {
  soPhieu      Int
  mssp         String
  tenThuongMai String?
  tenPhanBon   String?
  quyCach      String
  quyCachThung Int
  donGia       Int
  soLuongThung Int
  soHangLe     Int     @default(0)
  tongTien     Int     @default(0)

  xuatHang   XuatHang             @relation(fields: [soPhieu], references: [soPhieu], onDelete: Cascade, onUpdate: Cascade)
  nguyenLieu XuatHangNguyenLieu[]
  vatTu      XuatHangVatTu[]

  @@id([soPhieu, mssp])
  @@map("xuat_hang_san_pham")
}

model SanXuatSanPham {
  id           String              @id @default(cuid())
  sanXuatId    Int                 @unique
  sanXuat      SanXuat             @relation(fields: [sanXuatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mssp         String
  tenThuongMai String?
  tenPhanBon   String?
  donGia       Int
  tiTrong      Float?
  khoiLuong    Float               @default(0)
  nguyenLieu   SanXuatNguyenLieu[]

  @@map("san_xuat_san_pham")
}

model XuatHang {
  soPhieu         Int               @id @default(autoincrement())
  mskh            String
  ngayXuatHang    DateTime          @default(now())
  nguoiLapPhieuId String
  khachHang       KhachHang         @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)
  nguoiLapPhieu   User              @relation(fields: [nguoiLapPhieuId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  diaChiGiaoHang  String            @default("Nhận tại kho")
  sdtChanh        String?
  sanPham         XuatHangSanPham[]

  @@map("xuat_hang")
}

model SanXuat {
  id          Int             @id @default(autoincrement())
  mskh        String
  ngaySanXuat DateTime        @default(now())
  khachHang   KhachHang       @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)
  sanPham     SanXuatSanPham?

  @@map("san_xuat")
}

enum LoaiHangNhap {
  NGUYEN_LIEU
  VAT_TU
}

model NhapHang {
  id         String       @id @default(cuid())
  ngayNhap   DateTime     @default(now())
  loai       LoaiHangNhap
  maHangNhap String
  donGia     Int
  soLuong    Int
  tongTien   Int

  @@map("nhap_hang")
}

model ThuTien {
  soPhieu   Int       @id @default(autoincrement())
  ngayThu   DateTime  @default(now())
  mskh      String
  soTien    Int
  lyDo      String
  noiNhan   String
  khachHang KhachHang @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@map("thu_tien")
}

model CongNo {
  id        Int       @id @default(autoincrement())
  ngay      DateTime  @default(now())
  mskh      String
  tongTien  Int
  noiDung   String
  khachHang KhachHang @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)

  @@map("cong_no")
}
