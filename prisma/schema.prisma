generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum LoaiVatTu {
  THUNG // Thùng
  CHAI
  NHAN // Nhãn
  TUI // Túi
  BAO
}

model VatTu {
  ms        String    @id
  ten       LoaiVatTu
  loai      String
  mskh      String
  khachHang KhachHang @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)

  @@map("vat_tu")
}

model KhachHang {
  mskh        String    @id
  ten         String
  tenCongTy   String?
  diaChi      String
  email       String?
  maSoThue    String?
  soDienThoai String?
  tinh        String
  vatTu       VatTu[]
  sanPham     SanPham[]

  @@map("khach_hang")
}

model SanPham {
  mssp         String               @id
  mskh         String
  tenThuongMai String
  tenPhanBon   String
  quyCach      String
  quyCachThung Int
  donGia       Int
  khachHang    KhachHang            @relation(fields: [mskh], references: [mskh], onDelete: Restrict, onUpdate: Cascade)
  nguyenLieu   CongThucNguyenLieu[]

  @@map("san_pham")
}

model NguyenLieu {
  id      String               @id @default(cuid())
  ten     String
  donVi   String
  loai    String
  gia     NguyenLieuDonGia[]
  sanPham CongThucNguyenLieu[]

  @@map("nguyen_lieu")
}

model CongThucNguyenLieu {
  mssp         String
  nguyenLieuId String
  giaTri       Decimal    @db.Decimal(12, 3)
  sanPham      SanPham    @relation(fields: [mssp], references: [mssp], onDelete: Cascade, onUpdate: Cascade)
  nguyenLieu   NguyenLieu @relation(fields: [nguyenLieuId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([mssp, nguyenLieuId])
  @@map("cong_thuc_nguyen_lieu")
}

model NguyenLieuDonGia {
  id           String     @id @default(cuid())
  nguyenLieuId String
  ngay         DateTime   @db.Date
  donGia       Int
  nguyenLieu   NguyenLieu @relation(fields: [nguyenLieuId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([nguyenLieuId, ngay])
  @@index([nguyenLieuId, ngay])
  @@map("nguyen_lieu_don_gia")
}
